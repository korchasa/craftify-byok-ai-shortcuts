.DS_Store
build/
# Xcode project user data and workspace settings
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.xcuserdatad
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# SwiftPM and XcodeGen
.swiftpm/
.build/
Package.resolved

# Mint
.mint/

# DerivedData (Xcode build cache, not in repo but often in CI)
DerivedData/

# Autogenerated localization and SwiftGen files
src/**/Resources/Generated/
!src/**/Resources/Generated/.gitkeep
src/**/Generated/
!src/**/Generated/.gitkeep

# User/IDE settings
.idea/
*.swp
*.swo
*.orig

# Fastlane and CI artifacts
fastlane/report.xml
fastlane/test_output/
fastlane/screenshots/
fastlane/Preview.html
fastlane/tmp/

# Coverage and test reports
*.xccovreport
*.xccovarchive
*.gcno
*.gcda
*.profraw
*.profdata
coverage/

# Byproducts
*.ipa
*.dSYM
*.app
*.xcarchive
*.log

# Temporary files
*.tmp
*.temp

# Docker
*.pid

# Tuist/XcodeGen generated projects (если не используются вручную)
*.xcodeproj/
*.xcworkspace/
Derived/

# Эмулируемый лог
emulator.log

# Tuist/XcodeGen автогенерируемые файлы
Derived/InfoPlists/
Derived/Sources/

# Не игнорировать .gitkeep в автогенерируемых папках
!src/**/Resources/Generated/.gitkeep
!src/**/Generated/.gitkeep

documents/whiteboard.md
check_url.sh
