#!/bin/bash
set -e

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

function help() {
  echo "Usage: ./run <command> [args...]"
  echo "Commands:"
  echo "  test         - Запуск всех тестов"
  echo "  build        - Сборка MainApp и ShareExtension"
  echo "  check-size   - Проверка размера ShareExtension"
  echo "  dev          - Сборка и запуск MainApp в симуляторе iPhone 14 (iOS 16.4)"
  echo "  clean        - Очистка артефактов сборки"
  echo "  logs         - Показать device logs (симулятор)"
  echo "  help         - Показать эту справку"
  echo "\nЛюбые дополнительные параметры после <command> будут переданы в соответствующий инструмент."
}

function ensure_mint() {
  if ! command -v mint &> /dev/null; then
    echo -e "${RED}Mint не найден. Установите через 'brew install mint'.${NC}"
    exit 1
  fi
}

SIMULATOR_ID=EE50483C-9861-438F-82D0-52FFB8FDF92C

CMD="$1"
shift || true # Удаляем имя команды, остальные параметры в $@

ensure_mint

# Универсальная обертка для xcodebuild с xcbeautify
function run_xcodebuild() {
  NSUnbufferedIO=YES xcodebuild -sdk iphonesimulator -destination "id=$SIMULATOR_ID" "$@" | mint run xcbeautify
  if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    echo -e "${RED}xcodebuild failed!${NC}"
    exit 1
  fi
}

case "$CMD" in
  fmt)
    echo ">>>> Run swiftformat"
    mint run swiftformat . "$@" || { echo -e "${RED}SwiftFormat обнаружил ошибки! All other tests will be skipped.${NC}"; exit 1; }
    ;;
  lint)
    echo ">>>> Run swiftlint"
    mint run swiftlint --strict "$@" || { echo -e "${RED}SwiftLint обнаружил ошибки! All other tests will be skipped.${NC}"; exit 1; }
    ;;
  test)
    ./run fmt "$@"
    ./run lint "$@"

    echo ">>>> Run all unit tests"
    mint run xcodegen "$@"
    open --background -a Simulator
    run_xcodebuild -scheme MainAppUnitTests test "$@"
    run_xcodebuild -scheme ShareExtensionUnitTests test "$@"
    run_xcodebuild -scheme CraftifySharedUnitTests test "$@"

    echo ">>>> Run all E2E tests"
    mint run xcodegen "$@"
    open --background -a Simulator
    run_xcodebuild -scheme MainAppE2ETests test "$@"
    run_xcodebuild -scheme ShareExtensionE2ETests test "$@"
    run_xcodebuild -scheme CraftifySharedE2ETests test "$@"
    ;;
  build)
    echo ">>>> Build MainApp (Release, iphoneos) — production warnings"
    NSUnbufferedIO=YES xcodebuild build \
      -scheme MainApp \
      -configuration Release \
      -sdk iphoneos \
      -derivedDataPath build \
      BUILD_DIR=build/Products \
      -allowProvisioningUpdates | mint run xcbeautify
    if [ ${PIPESTATUS[0]} -ne 0 ]; then
      echo -e "${RED}xcodebuild build MainApp failed!${NC}"
      exit 1
    fi
    echo ">>>> Build ShareExtension (Release, iphoneos) — production warnings"
    NSUnbufferedIO=YES xcodebuild build \
      -scheme ShareExtension \
      -configuration Release \
      -sdk iphoneos \
      -derivedDataPath build \
      BUILD_DIR=build/Products \
      -allowProvisioningUpdates | mint run xcbeautify
    if [ ${PIPESTATUS[0]} -ne 0 ]; then
      echo -e "${RED}xcodebuild build ShareExtension failed!${NC}"
      exit 1
    fi
    ;;
  check-size)
    echo ">>>> Generating Xcode project"
    mint run xcodegen "$@"
    echo ">>>> Cleaning previous build artifacts"
    rm -rf build
    echo ">>>> Building ShareExtension (Release, iphoneos)"
    NSUnbufferedIO=YES xcodebuild build \
      -scheme ShareExtension \
      -configuration Release \
      -sdk iphoneos \
      -derivedDataPath build \
      BUILD_DIR=build/Products | mint run xcbeautify
    if [ ${PIPESTATUS[0]} -ne 0 ]; then
      echo -e "${RED}xcodebuild build failed!${NC}"
      exit 1
    fi
    EXT_PATH="build/Products/Release-iphoneos/ShareExtension.appex"
    if [ ! -d "$EXT_PATH" ]; then
      echo -e "${RED}No .appex found at $EXT_PATH${NC}"
      exit 1
    fi
    # Получаем размер в килобайтах
    SIZE_KB=$(du -sk "$EXT_PATH" | awk '{print $1}')
    # Переводим в мегабайты (округление вверх)
    SIZE_MB=$(( (SIZE_KB + 1023) / 1024 ))
    echo "ShareExtension size: ${SIZE_MB} MB"
    if (( SIZE_MB > 20 )); then
      echo -e "${RED}ShareExtension size exceeds 20MB!${NC}"
      exit 1
    fi
    ;;
  dev)
    mint run xcodegen "$@"
    open --background -a Simulator
    run_xcodebuild -scheme MainApp build "$@"
    xcrun simctl boot $SIMULATOR_ID || true
    xcrun simctl install $SIMULATOR_ID "$(xcodebuild -scheme MainApp -sdk iphonesimulator -showBuildSettings | grep -m1 'BUILT_PRODUCTS_DIR =' | awk '{print $3}')/MainApp.app"
    xcrun simctl launch $SIMULATOR_ID dev.korchasa.Craftify
    ;;
  clean)
    rm -rf build
    xcodebuild clean -scheme MainApp "$@" || true
    xcodebuild clean -scheme ShareExtension "$@" || true
    xcodebuild clean -scheme CraftifyShared "$@" || true
    ;;
  logs)
    xcrun simctl spawn booted log stream --predicate 'process == "MainApp"' --style syslog "$@"
    ;;
  help|--help|-h|*)
    help
    ;;
esac