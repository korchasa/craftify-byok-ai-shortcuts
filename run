#!/usr/bin/env bash
set -euo pipefail

# Default iOS Simulator UDID (override SIMULATOR_ID env var)
SIMULATOR_ID="EE50483C-9861-438F-82D0-52FFB8FDF92C"
# Simulator for tests
TEST_SIMULATOR_ID="A6CB3FE3-9CF3-458C-AC2E-7307FDF8D816"

# Colors for output
RED='\033[0;31m'
PURPLE='\033[0;35m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

SCRIPT_NAME=$(basename "${0}")

# Add xcb wrapper for xcodebuild with xcbeautify
function xcb() {
  xcodebuild -showBuildTimingSummary "$@" 2>&1 | grep -v 'DVTDeviceOperation: Encountered a build number' | xcbeautify --quiet --disable-logging
}

# Define arrays for test schemes
SCHEMES_UNIT=(MainAppUnitTests ShareExtensionUnitTests CommonUnitTests)
SCHEMES_E2E=(MainAppE2ETests ShareExtensionE2ETests CommonE2ETests)
SCHEMES_ALL_TESTS=("${SCHEMES_UNIT[@]}" "${SCHEMES_E2E[@]}")

# Default parallel testing worker count
WORKER_COUNT=${TEST_WORKER_COUNT:-$(sysctl -n hw.ncpu)}
# Runtime test filters
ONLY_TEST_FLAGS=()
if [[ -n "${ONLY_TESTING:-}" ]]; then
  ONLY_TEST_FLAGS+=("-only-testing" "${ONLY_TESTING}")
fi

function usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [args...]
Commands:
  analyze             Run static analysis
  archive             Archive MainApp as .xcarchive
  build               Build MainApp and ShareExtension (Release)
  bump-version        Bump version numbers via agvtool
  clean               Clean build artifacts
  comment-scan        Scan for TODO/FIXME/print/debugPrint
  deploy:adhoc        Ad-hoc TestFlight deploy
  deploy:appstore     Upload to App Store Connect
  deploy:internal     Internal TestFlight deploy
  deploy:simulator    Build MainApp for simulator
  deploy:testflight   Upload IPA to TestFlight via altool
  export-ipa          Export IPA from archive
  generate            Run SwiftGen and XcodeGen
  init                Install CLI tools
  logs                Stream MainApp logs
  monitor-setup       Setup monitoring (Sentry etc.)
  notify              Send notifications (Slack, email)
  size-report         Check ShareExtension size
  check               Run all checks(clean, generate, comment-scan, fmt, lint, analyze, test_unit, test_e2e)
  test:coverage       Run tests with code coverage
  test:single         Run a single test or class (unit or e2e), for example: $SCRIPT_NAME test:single MainAppUnitTests MainAppUnitTests/AddOperationViewModelTests
  help                Show this help
EOF
}

function init() {
  echo -e "${GREEN}Checking CLI tools via Homebrew...${NC}"
  local tools=(xcodegen swiftlint swiftformat xcbeautify swiftgen)
  for tool in "${tools[@]}"; do
    if ! command -v $tool &>/dev/null; then
      echo "Installing $tool..."
      brew install $tool
    else
      echo "$tool is already installed"
    fi
  done
  echo -e "${GREEN}All dependencies checked.${NC}"
}

function _start_section() {
  echo -e "\n\n"
  echo -e "${PURPLE}========================================${NC}"
  echo -e "${PURPLE}>>> $1${NC}"
  SECTION_START_TIME=$(date +%s)
}

function _end_section() {
  local section_end_time=$(date +%s)
  local elapsed=$((section_end_time - SECTION_START_TIME))
  echo -e "${GREEN}<<< Section finished in ${elapsed}s${NC}"
  echo -e "${GREEN}========================================${NC}"
}

function clean() {
  _start_section "Cleaning build artifacts"
  rm -rf build
  rm -rf .build
  rm -rf .swiftpm
  rm -rf ~/Library/Developer/Xcode/DerivedData
  xcb clean || true
  _end_section
}

function generate() {
  mkdir -p src/MainApp/Resources/Generated
  mkdir -p src/Common/Generated
  _start_section "Running SwiftGen"
  swiftgen "$@"
  _end_section
  _start_section "Running XcodeGen"
  xcodegen "$@"
  _end_section
}

function fmt() {
  _start_section "Running SwiftFormat"
  swiftformat . --quiet "$@"
  _end_section
}

function lint() {
  _start_section "Running SwiftLint"
  swiftlint lint --fix --quiet
  swiftlint lint --strict --quiet
  _end_section
}

function _run_schemes_parallel() {
  local schemes=("${!1}")
  shift
  local pids=()
  rm -rf build/Results
  for scheme in "${schemes[@]}"; do
    local derived_data_path="build/DerivedData_${scheme}"
    rm -rf "$derived_data_path"
    echo "⚙️ Testing scheme $scheme"
    xcb test -sdk iphonesimulator -destination "id=${TEST_SIMULATOR_ID},arch=arm64" -scheme "${scheme}" \
      -parallel-testing-enabled YES -parallel-testing-worker-count "${WORKER_COUNT}" \
      -derivedDataPath "$derived_data_path" \
      -resultBundlePath "build/Results/${scheme}.xcresult" \
      -collect-test-diagnostics on-failure \
      "${ONLY_TEST_FLAGS[@]}" "$@" &
    pids+=("$!")
  done
  local exit_code=0
  for i in "${!pids[@]}"; do
    pid="${pids[$i]}"
    scheme="${schemes[$i]}"
    wait "$pid" || exit_code=1
    echo "✅ Finished scheme $scheme"
  done
  if [[ $exit_code -ne 0 ]]; then
    echo -e "${RED}One or more test schemes failed!${NC}"
    exit 1
  fi
}

function test_unit() {
  _start_section "Running Unit Tests"
  _run_schemes_parallel SCHEMES_UNIT[@] "$@"
  _end_section
}

function test_e2e() {
  _start_section "Running E2E Tests"
  _run_schemes_parallel SCHEMES_E2E[@] "$@"
  _end_section
}

function test_single() {
  local scheme="${1:-}"
  shift || true
  local test_id="${1:-}"
  shift || true
  local valid=0
  for s in "${SCHEMES_UNIT[@]}" "${SCHEMES_E2E[@]}"; do
    if [[ "$scheme" == "$s" ]]; then
      valid=1
      break
    fi
  done
  if [[ -z "$scheme" || $valid -eq 0 ]]; then
    echo -e "${RED}Error: You must specify a valid test scheme!${NC}"
    echo -e "\nAvailable unit test schemes:" && for s in "${SCHEMES_UNIT[@]}"; do echo "  $s"; done
    echo -e "\nAvailable e2e test schemes:" && for s in "${SCHEMES_E2E[@]}"; do echo "  $s"; done
    exit 1
  fi
  local t0=$(date +%s)
  _start_section "Running single test: $test_id in scheme $scheme"
  echo -e "${YELLOW}==> test_single: Start at $(date)${NC}"
  rm -rf build/Results
  local t1=$(date +%s)
  echo -e "${YELLOW}==> Build start: $(date)${NC}"
  xcodebuild test -showBuildTimingSummary \
    -sdk iphonesimulator \
    -destination "id=${TEST_SIMULATOR_ID}" \
    -scheme "$scheme" \
    -parallel-testing-enabled YES \
    -parallel-testing-worker-count "${WORKER_COUNT}" \
    -resultBundlePath "build/Results/${scheme}.xcresult" \
    -collect-test-diagnostics on-failure \
    -only-testing "$test_id" "$@" 2>&1 | tee build/TimingSummary.log | grep -v 'DVTDeviceOperation: Encountered a build number' | xcbeautify --quiet --disable-logging
  local t2=$(date +%s)
  echo -e "${YELLOW}==> Build+Test finished: $(date)${NC}"
  _end_section
  local t3=$(date +%s)
  echo -e "${YELLOW}==> test_single: Finished at $(date)${NC}"
  echo -e "${YELLOW}==> Timing:${NC}"
  echo "  Prepare:   $((t1-t0))s"
  echo "  Build+Run: $((t2-t1))s"
  echo "  Cleanup:   $((t3-t2))s"
  echo "  TOTAL:     $((t3-t0))s"
  echo -e "${YELLOW}==> Build timing summary saved to build/TimingSummary.log${NC}"
}

function test() {
  clean
  generate
  comment_scan
  fmt
  lint
  analyze
  test_unit
  test_e2e
}

function build() {
  generate "$@"
  _start_section "Building MainApp (Release/iphoneos)"
  xcb build -scheme MainApp -configuration Release -sdk iphoneos -derivedDataPath build -allowProvisioningUpdates "$@"
  _end_section
  _start_section "Building ShareExtension (Release/iphoneos)"
  xcb build -scheme ShareExtension -configuration Release -sdk iphoneos -derivedDataPath build -allowProvisioningUpdates "$@"
  _end_section
}

function size_report() {
  generate "$@"
  _start_section "Cleaning build artifacts"
  rm -rf build
  _end_section
  _start_section "Building ShareExtension for size report (Release/iphoneos)"
  xcb build -scheme ShareExtension -configuration Release -sdk iphoneos -derivedDataPath build "$@"
  _end_section
  local appex=$(find build -name 'ShareExtension.appex' | head -n1)
  if [[ ! -f "$appex" ]]; then
    echo -e "${RED}Error: ShareExtension.appex not found!${NC}"
    exit 1
  fi
  local size_bytes=$(stat -f%z "$appex")
  local size_mb=$(awk "BEGIN {printf \"%.2f\", $size_bytes/1024/1024}")
  echo "ShareExtension.appex size: ${size_mb} MB (${size_bytes} bytes)"
  if (( $(echo "${size_mb} > 20.0" | bc -l) )); then
    echo -e "${RED}Error: ShareExtension size exceeds 20MB!${NC}"
    exit 1
  fi
}

function _boot_and_wait_simulator() {
  local sim_status
  sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')
  _start_section "Simulator ${SIMULATOR_ID} status: $sim_status"
  if [[ "$sim_status" != "Booted" ]]; then
    _start_section "Booting simulator ${SIMULATOR_ID}..."
    xcrun simctl boot "${SIMULATOR_ID}"
    for i in {1..20}; do
      sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')
      if [[ "$sim_status" == "Booted" ]]; then
        break
      fi
      sleep 1
    done
    _end_section
  else
    _start_section "Simulator already Booted."
    _end_section
  fi
  _end_section
}

function _install_app_to_simulator() {
  local app_path="$1"
  if [[ ! -d "$app_path" ]]; then
    echo "${RED}MainApp.app not found at $app_path!${NC}"
    exit 2
  fi
  local install_success=0
  for attempt in {1..5}; do
    if xcrun simctl install "${SIMULATOR_ID}" "${app_path}"; then
      install_success=1
      break
    else
      local delay=$((2 ** (attempt - 1)))
      echo "Install attempt $attempt failed, retrying in ${delay}s..."
      sleep "${delay}"
    fi
  done
  if [[ $install_success -eq 0 ]]; then
    echo "${RED}Failed to install app after multiple attempts!${NC}"
    exit 2
  fi
}

function deploy_simulator() {
  clean
  generate "$@"
  if [[ -z "${CI:-}" ]]; then
    _start_section "Opening Simulator"
    open -a Simulator
    _end_section
  fi
  _start_section "Building MainApp for simulator"
  local derived_data_path="build/DerivedData_DeploySimulator"
  rm -rf "$derived_data_path"
  xcb build -sdk iphonesimulator -destination "id=${SIMULATOR_ID},arch=arm64" -scheme MainApp build -derivedDataPath "$derived_data_path" "$@"
  _end_section
  _boot_and_wait_simulator
  local app_path
  app_path=$(xcodebuild -scheme MainApp -destination "id=${SIMULATOR_ID},arch=arm64" -sdk iphonesimulator -derivedDataPath "$derived_data_path" -showBuildSettings | awk -F'= ' '/BUILT_PRODUCTS_DIR/ {print $2"/MainApp.app"}' | head -n1)
  _start_section "Installing app to simulator: $app_path"
  _install_app_to_simulator "$app_path"
  _end_section
  _start_section "Launching app in simulator: $app_path"
  xcrun simctl launch "${SIMULATOR_ID}" "dev.korchasa.Craftify"
  _end_section
  _start_section "Starting log stream to emulator.log (background)"
  xcrun simctl spawn booted log stream --predicate '(subsystem == "Internal") && (process == "MainApp" OR process == "ShareExtension")' --style syslog --level=debug > emulator.log 2>&1 &
  LOG_STREAM_PID=$!
  tail -f emulator.log
  _end_section
}

function logs() {
  _start_section "Streaming logs from MainApp и ShareExtension (все уровни, включая debug)"
  xcrun simctl spawn booted log stream --predicate '(subsystem == "Internal") && (process == "MainApp" OR process == "ShareExtension")' --style syslog --level=debug
  _end_section
}

function comment_scan() {
  _start_section "Scanning for TODO/FIXME/print/debugPrint"
  if grep -rE 'TODO|FIXME|print\(|debugPrint\(' src/; then
    echo -e "${RED}Error: TODO/FIXME/print/debugPrint found!${NC}"
    exit 1
  fi
  _end_section
}

function bump_version() {
  _start_section "Bumping version numbers"
  local marketing="${1:-}"
  if [[ -z "$marketing" ]]; then
    agvtool next-version -all
  else
    agvtool new-marketing-version "$marketing"
    agvtool next-version -all
  fi
  _end_section
}

function archive() {
  generate "$@"
  _start_section "Archiving MainApp"
  xcb archive \
    -scheme MainApp \
    -configuration Release \
    -archivePath build/MainApp.xcarchive \
    -allowProvisioningUpdates "$@"
  _end_section
}

function export_ipa() {
  _start_section "Exporting IPA from archive"
  xcb -exportArchive \
    -archivePath build/MainApp.xcarchive \
    -exportOptionsPlist ExportOptions.plist \
    -exportPath build/IPA "$@"
  _end_section
}

function deploy_testflight() {
  _start_section "Deploying IPA to TestFlight"
  if [[ -z "${API_KEY_PATH:-}" || -z "${API_ISSUER_ID:-}" ]]; then
    echo -e "${RED}Error: API_KEY_PATH or API_ISSUER_ID env vars not set${NC}"
    exit 1
  fi
  xcrun altool \
    --upload-app --type ios \
    --file build/IPA/MainApp.ipa \
    --apiKey "$API_KEY_PATH" --apiIssuer "$API_ISSUER_ID"
  _end_section
}

function coverage() {
  generate "$@"
  _start_section "Running tests with code coverage"
  xcb test \
    -scheme MainAppUnitTests \
    -enableCodeCoverage YES \
    -sdk iphonesimulator \
    -destination "id=${TEST_SIMULATOR_ID}" "$@"
  _end_section
  _start_section "Generating coverage report"
  xcrun xccov view --report build/Logs/Test/*.xcresult
  _end_section
}

function _build_sim() {
  _start_section "Building for Simulator (Debug)"
  xcb build \
    -scheme MainApp \
    -configuration Debug \
    -sdk iphonesimulator \
    -destination "id=${SIMULATOR_ID},arch=arm64" "$@"
  _end_section
}

function analyze() {
  _start_section "Running static analysis"
  xcb analyze \
    -scheme MainApp \
    -sdk iphoneos \
    -destination "id=${SIMULATOR_ID},arch=arm64" \
    -configuration Debug "$@"
  _end_section
}

function _export_ipa_adhoc() {
  _start_section "Exporting AdHoc IPA"
  xcb -exportArchive \
    -archivePath build/MainApp.xcarchive \
    -exportOptionsPlist ExportOptionsAdHoc.plist \
    -exportPath build/IPA/ad-hoc "$@"
  _end_section
}

function deploy_internal() {
  _start_section "Deploying to internal TestFlight"
  deploy_testflight "$@"
  _end_section
}

function deploy_adhoc() {
  _start_section "Deploying AdHoc distribution"
  deploy_testflight "$@"
  _end_section
}

function deploy_appstore() {
  _start_section "Uploading to App Store Connect"
  xcrun altool \
    -upload-app --type ios \
    -file build/IPA/MainApp.ipa \
    -apiKey "$API_KEY_PATH" --apiIssuer "$API_ISSUER_ID"
  _end_section
}

function notify() {
  _start_section "Sending notifications"
  # integrate Slack/email notifications here
  _end_section
}

function monitor_setup() {
  _start_section "Setting up monitoring"
  # configure Sentry or other services
  _end_section
}

function pr_checks() {
  _start_section "Running PR checks (e.g. TODO/FIXME scan)"
  comment_scan "$@"
  _end_section
}

function _collect_dsyms() {
  _start_section "Collecting artifacts & dSYMs"
  mkdir -p build/Artifacts
  cp -R build/MainApp.xcarchive/dSYMs build/Artifacts/
  _end_section
}

function check() {
  clean
  generate
  comment_scan
  fmt
  lint
  analyze
  test_unit
  test_e2e
}

CMD="${1:-}"
shift || true

case "$CMD" in
  analyze) analyze "$@" ;;             # Static analysis
  archive) archive "$@" ;;             # Archive MainApp for distribution
  build) build "$@" ;;                 # Build release targets
  bump-version) bump_version "$@" ;;   # Bump version numbers
  clean) clean "$@" ;;                 # Clean artifacts
  comment-scan) comment_scan "$@" ;;   # TODO/FIXME scan
  deploy:adhoc) deploy_adhoc "$@" ;;             # Ad-hoc TestFlight deploy
  deploy:appstore) deploy_appstore "$@" ;;       # Upload to App Store Connect
  deploy:internal) deploy_internal "$@" ;;       # TestFlight internal deploy
  deploy:simulator) deploy_simulator "$@" ;;     # Run app in simulator
  deploy:testflight) deploy_testflight "$@" ;;   # Upload to TestFlight via API key
  export-ipa) export_ipa "$@" ;;       # Export IPA from archive
  generate) generate "$@" ;;           # SwiftGen & XcodeGen
  init) init "$@" ;;                   # Install CLI tools
  logs) logs "$@" ;;                   # Stream device logs
  monitor-setup) monitor_setup "$@" ;; # Setup monitoring (Sentry etc.)
  notify) notify "$@" ;;               # Send notifications (Slack, email)
  size-report) size_report "$@" ;;     # Check ShareExtension size
  test:coverage) coverage "$@" ;;      # Run code coverage
  test:single) test_single "$@" ;;     # Run a single test or class
  check) check "$@" ;;                 # Run all checks(clean, generate, comment-scan, fmt, lint, analyze, test_unit, test_e2e)
  help|*) usage ;;                     # Show help
esac