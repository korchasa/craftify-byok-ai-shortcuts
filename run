#!/usr/bin/env bash
set -euo pipefail

# Default iOS Simulator UDID (override SIMULATOR_ID env var)
SIMULATOR_ID="442113FE-1B01-46F6-82FA-203D9317AD2A"
# Simulator for tests
TEST_SIMULATOR_ID="3B103AF0-92C8-4707-9D34-7D9916D4B798"

# Colors for output
RED='\033[0;31m'
PURPLE='\033[0;35m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

SCRIPT_NAME=$(basename "${0}")

# Default parallel testing worker count
WORKER_COUNT=${TEST_WORKER_COUNT:-$(sysctl -n hw.ncpu)}
DEST_SIMULATOR="id=${SIMULATOR_ID},arch=arm64"
DEST_TEST_SIMULATOR="id=${TEST_SIMULATOR_ID},arch=arm64"
DERIVED_DATA_SIM=build/DerivedData_DeploySimulator

function usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [args...]
Commands:
  clean          Full clean: deletion of all builds, caches, logs, and temporary files
  sim                 Build MainApp for simulator
  generate            Run SwiftGen and Tuist
  init                Install CLI tools
  logs                Stream MainApp logs
  check               Run all checks (clean, generate, comment-scan, fmt, lint, analyze, build, test)
  test <test_id>      Run a test by id (e.g. MainAppUnitTests/TestExample). Always uses All plan.
  help                Show this help
EOF
}

function init() {
  echo -e "${GREEN}Checking CLI tools via Homebrew...${NC}"
  local tools=(tuist swiftlint swiftformat swiftgen)
  for tool in "${tools[@]}"; do
    if ! command -v $tool &>/dev/null; then
      echo "Installing $tool..."
      brew install $tool
    else
      echo "$tool is already installed"
    fi
  done
  echo -e "${GREEN}All dependencies checked.${NC}"
}

function _start_section() {
  echo -e "${PURPLE}========================================${NC}"
  echo -e "${PURPLE}>>> $1${NC}"
  SECTION_START_TIME=$(date +%s)
}

function _end_section() {
  local section_end_time=$(date +%s)
  local elapsed=$((section_end_time - SECTION_START_TIME))
  echo -e "${GREEN}<<< Section finished in ${elapsed}s${NC}"
  echo -e "${GREEN}========================================${NC}"
}

function clean() {
  _start_section "Cleaning build artifacts"
  rm -rf build
  rm -rf .build
  rm -rf .swiftpm
  rm -rf ~/Library/Developer/Xcode/DerivedData
  rm -rf ~/Library/Caches/org.swift.swiftpm
  rm -rf build/SourcePackages
  _end_section
}

function generate() {
  mkdir -p src/MainApp/Resources/Generated
  mkdir -p src/Common/Generated
  _start_section "Running SwiftGen"
  swiftgen "$@"
  _end_section
  _start_section "Running Tuist generate"
  tuist generate "$@" --no-open
  _end_section
}

function fmt() {
  _start_section "Running SwiftFormat"
  swiftformat . --quiet "$@"
  _end_section
}

function lint() {
  _start_section "Running SwiftLint"
  local output
  local exit_code=0
  output=$(swiftlint lint --fix --quiet || exit_code=$?)
  if [[ -n "$output" ]]; then
    echo "$output"
    echo -e "${RED}SwiftLint found issues!${NC}"
    exit 1
  fi
  output=$(swiftlint lint --strict --quiet || exit_code=$?)
  if [[ -n "$output" ]]; then
    echo "$output"
    echo -e "${RED}SwiftLint (strict) found issues!${NC}"
    exit 1
  fi
  _end_section
  _start_section "Running Periphery (dead code analysis)"
  if ! command -v periphery &>/dev/null; then
    echo -e "${YELLOW}Periphery not found, skipping dead code analysis. Install with: brew install peripheryapp/periphery/periphery${NC}"
  else
    periphery scan --config .periphery.yml --format xcode --strict --quiet || {
      echo -e "${RED}Periphery found dead code!${NC}"
      exit 1
    }
  fi
  _end_section
}

function size_report() {
  generate "$@"
  _start_section "Cleaning build artifacts"
  rm -rf build
  _end_section
  _start_section "Building ShareExtension for size report (Release/iphoneos)"
  tuist build ShareExtension --build-output-path build/Products -- -configuration Release -sdk iphoneos
  _end_section
  local appex_paths=( $(find build/Products -name 'ShareExtension.appex') )
  if [[ ${#appex_paths[@]} -eq 0 ]]; then
    echo -e "${RED}Error: ShareExtension.appex not found!${NC}"
    exit 1
  fi
  local error=0
  for appex in "${appex_paths[@]}"; do
    local size_mb=$(du -sm "$appex" | awk '{print $1}')
    local size_bytes=$(du -sk "$appex" | awk '{print $1 * 1024}')
    local size_mb_float=$(awk "BEGIN {printf \"%.2f\", $size_bytes/1024/1024}")
    echo "ShareExtension.appex at $appex size: ${size_mb_float} MB (${size_bytes} bytes)"
    if (( $(echo "$size_mb_float > 20.0" | bc -l) )); then
      echo -e "${RED}Error: ShareExtension size at $appex exceeds 20MB!${NC}"
      error=1
    fi
  done
  if [[ $error -ne 0 ]]; then
    exit 1
  fi
}

function _boot_and_wait_simulator() {
  # Verify that the simulator with the given UDID exists
  local sim_status
  sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')

  if [[ -z "$sim_status" ]]; then
    echo -e "${RED}Simulator with UDID ${SIMULATOR_ID} not found.\nPlease set SIMULATOR_ID to an existing device (e.g. iOS 16.4 simulator).${NC}"
    echo -e "${YELLOW}Tip: Run \`xcrun simctl list devices available\` to see available simulators and their UDIDs.${NC}"
    exit 1
  fi

  _start_section "Simulator ${SIMULATOR_ID} status: $sim_status"
  if [[ "$sim_status" != "Booted" ]]; then
    _start_section "Booting simulator ${SIMULATOR_ID}..."
    xcrun simctl boot "${SIMULATOR_ID}"
    xcrun simctl bootstatus "${SIMULATOR_ID}" -b
    _end_section
  else
    _start_section "Simulator already Booted."
    _end_section
  fi
  _end_section
}

function _install_app_to_simulator() {
  local app_path="$1"
  if [[ ! -d "$app_path" ]]; then
    echo "${RED}MainApp.app not found at $app_path!${NC}"
    exit 2
  fi
  local install_success=0
  for attempt in {1..5}; do
    if xcrun simctl install "${SIMULATOR_ID}" "${app_path}"; then
      install_success=1
      break
    else
      local delay=$((2 ** (attempt - 1)))
      echo "Install attempt $attempt failed, retrying in ${delay}s..."
      sleep "${delay}"
    fi
  done
  if [[ $install_success -eq 0 ]]; then
    echo "${RED}Failed to install app after multiple attempts!${NC}"
    exit 2
  fi
}

function fast_check_build_analyze_test() {
  _start_section "Fast build+test (MainApp, ShareExtension, AllUnitTests)"
  local t0=$(date +%s)
  BUNDLE_PATH="build/Results/AllTests.xcresult"
  DERIVED_DATA="build/DerivedData_FastCheck"
  rm -rf "$BUNDLE_PATH"
  # Build
  tuist build AllTests \
    --configuration Debug \
    -- \
    -sdk iphonesimulator \
    -destination "$DEST_TEST_SIMULATOR" \
    -derivedDataPath "$DERIVED_DATA" \
    -quiet
  # Test
  tuist test AllTests \
    --configuration Debug \
    -- \
    -sdk iphonesimulator \
    -destination "$DEST_TEST_SIMULATOR" \
    -derivedDataPath "$DERIVED_DATA" \
    -parallel-testing-enabled YES \
    -parallel-testing-worker-count "4" \
    -resultBundlePath "$BUNDLE_PATH" \
    -testLanguage en \
    -testRegion US \
    -quiet
  local exit_code=$?
  local t1=$(date +%s)
  _end_section
  local t2=$(date +%s)
  echo -e "${YELLOW}==> fast_check_build_analyze_test: Finished at $(date)${NC}"
  echo -e "${YELLOW}==> Timing:${NC}"
  echo "  Build+Test: $((t1-t0))s"
  echo "  Cleanup:   $((t2-t1))s"
  echo "  TOTAL:     $((t2-t0))s"
  return $exit_code
}

function deploy_simulator() {
  set -ex
  _start_section "Opening Simulator"
  open -a Simulator
  _end_section
  _start_section "Building MainApp for Simulator (Debug)"
  rm -rf "$DERIVED_DATA_SIM"
  tuist build MainApp --build-output-path build/Products -- -configuration Debug -sdk iphonesimulator -destination "$DEST_SIMULATOR" -quiet
  _end_section
  _boot_and_wait_simulator
  local app_path
  app_path="build/Products/Debug-iphonesimulator/MainApp.app"
  _start_section "Installing app to simulator: $app_path"
  _install_app_to_simulator "$app_path"
  _end_section
  _start_section "Launching app in simulator: $app_path"
  xcrun simctl launch "${SIMULATOR_ID}" "dev.korchasa.Craftify"
  _end_section
  if [[ "$SKIP_LOG_STREAM" == "1" ]]; then
    echo "Skipping log stream tail due to SKIP_LOG_STREAM=1"
    return
  fi
  _start_section "Starting log stream to emulator.log (background)"
  xcrun simctl spawn booted log stream --predicate '(subsystem == "Internal") && (process == "MainApp" OR process == "ShareExtension")' --style syslog --level=debug > emulator.log 2>&1 &
  LOG_STREAM_PID=$!
  tail -f emulator.log
  _end_section
}

function logs() {
  _start_section "Streaming logs from MainApp и ShareExtension (все уровни, включая debug)"
  xcrun simctl spawn booted log stream --predicate '(subsystem == "Internal") && (process == "MainApp" OR process == "ShareExtension")' --style syslog --level=debug
  _end_section
}

function comment_scan() {
  _start_section "Scanning for TODO/FIXME/print/debugPrint"
  if grep -rE --exclude-dir=src//Common/.build 'TODO|FIXME|print\(|debugPrint\(' src/; then
    echo -e "${RED}Error: TODO/FIXME/print/debugPrint found!${NC}"
    exit 1
  fi
  _end_section
}

function _test_scheme() {
  local scheme="$1"; shift
  local t0=$(date +%s)
  _start_section "Running tests scheme $scheme"
  BUNDLE_PATH="build/Results/${scheme}.xcresult"
  DERIVED_DATA="build/DerivedData_Test_${scheme}"
  rm -rf "$BUNDLE_PATH"
  local t1=$(date +%s)
  tuist test "$scheme" "$@" \
    --configuration Debug \
    -- \
    -sdk iphonesimulator \
    -destination "$DEST_TEST_SIMULATOR" \
    -derivedDataPath "$DERIVED_DATA" \
    -parallel-testing-enabled YES \
    -parallel-testing-worker-count "4" \
    -resultBundlePath "$BUNDLE_PATH" \
    -testLanguage en \
    -testRegion US \
    -quiet
  test_exit_code=$?
  local t2=$(date +%s)
  _end_section
  local t3=$(date +%s)
  echo -e "${YELLOW}==> test_scheme: Finished at $(date)${NC}"
  echo -e "${YELLOW}==> Timing:${NC}"
  echo "  Prepare:   $((t1-t0))s"
  echo "  Build+Run: $((t2-t1))s"
  echo "  Cleanup:   $((t3-t2))s"
  echo "  TOTAL:     $((t3-t0))s"
  if [ $test_exit_code -ne 0 ] && [ -f "$BUNDLE_PATH" ]; then
    echo -e "${RED}Test failures summary:${NC}"
    xcrun xcresulttool get --legacy --path "$BUNDLE_PATH" --format json | jq '.. | .testFailureSummaries? // empty'
  fi
  exit $test_exit_code
}

function full_clean() {
  _start_section "Full clean: удаление всех build, кэшей, логов и временных файлов"
  rm -rf build .build .swiftpm coverage *.log *.tmp *.temp
  rm -rf ~/Library/Developer/Xcode/DerivedData
  find . -type d -name DerivedData -exec rm -rf {} +
  find . -type f -name '*.xcresult' -delete
  find . -type f -name '*.ipa' -delete
  find . -type f -name '*.dSYM' -delete
  find . -type f -name '*.app' -delete
  find . -type f -name '*.xcarchive' -delete
  _end_section
}

function _find_first_available_iphone_sim() {
  local sim_name
  sim_name=$(xcrun simctl list devices available | grep -Eo 'iPhone [^\(]+' | head -n1 | xargs)
  if [[ -z "$sim_name" ]]; then
    echo "No available iPhone simulator found!" >&2
    exit 1
  fi
  echo "$sim_name"
}

function _get_device_by_uuid() {
  local uuid="$1"
  xcrun simctl list devices | grep "$uuid" | sed -E 's/^\s*([^\(]+) \(.*/\1/' | xargs
}

CMD="${1:-}"
shift || true

case "$CMD" in
  clean) full_clean "$@" ;;
  sim)
    generate
    deploy_simulator "$@"
  ;;
  generate) generate "$@" ;;
  init) init "$@" ;;
  logs) logs "$@" ;;
  size-report) size_report "$@" ;;
  test)
    if [[ -z "$1" ]]; then
      usage
      exit 1
    fi
    test_id="$1"; shift
    sim_uuid="${TEST_SIMULATOR_ID}"
    # Проверяем, существует ли симулятор с таким UUID
    if ! xcrun simctl list devices | grep "$sim_uuid"; then
      echo -e "${RED}Simulator with UUID $sim_uuid not found!${NC}"
      echo -e "${YELLOW}Available simulators:${NC}"
      xcrun simctl list devices | grep -Eo '([A-F0-9\-]{36})'
      exit 1
    fi
    _test_scheme AllTests --test-targets "$test_id" --no-selective-testing
    ;;
  check)
    generate || { echo -e "${RED}===CHECK_FAILED=== (generate)${NC}"; exit 1; }
    fmt || { echo -e "${RED}===CHECK_FAILED=== (fmt)${NC}"; exit 1; }
    lint || { echo -e "${RED}===CHECK_FAILED=== (lint)${NC}"; exit 1; }
    fast_check_build_analyze_test || { echo -e "${RED}===CHECK_FAILED=== (test)${NC}"; exit 1; }
    comment_scan || { echo -e "${RED}===CHECK_FAILED=== (comment_scan)${NC}"; exit 1; }
    deploy_simulator || { echo -e "${RED}===CHECK_FAILED=== (deploy_simulator)${NC}"; exit 1; }
    ;;
  help|*) usage ;;
esac