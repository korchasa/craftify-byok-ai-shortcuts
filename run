#!/usr/bin/env bash
set -euo pipefail

# Default iOS Simulator UDID (override SIMULATOR_ID env var)
SIMULATOR_ID="EE50483C-9861-438F-82D0-52FFB8FDF92C"
# Simulator for tests
TEST_SIMULATOR_ID="A6CB3FE3-9CF3-458C-AC2E-7307FDF8D816"

# Colors for output
RED='\033[0;31m'
PURPLE='\033[0;35m'
GREEN='\033[0;32m'
NC='\033[0m'

SCRIPT_NAME=$(basename "${0}")

# Add xcb wrapper for xcodebuild with xcbeautify
function xcb() {
  xcodebuild "$@" | xcbeautify
}

# Define arrays for test schemes
SCHEMES_UNIT=(MainAppUnitTests ShareExtensionUnitTests CommonUnitTests)
SCHEMES_E2E=(MainAppE2ETests ShareExtensionE2ETests CommonE2ETests)

function usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [args...]
Commands:
  generate            Run SwiftGen and XcodeGen
  fmt                 Run SwiftFormat
  lint                Run SwiftLint
  test:lint           Run SwiftLint (alias)
  test:format         Run SwiftFormat (alias)
  build:simulator     Build MainApp for simulator (Debug)
  analyze             Run static analysis
  test:unit           Run unit tests
  test:e2e            Run end-to-end tests
  test                Run all tests (unit + e2e)
  test:coverage       Run tests with code coverage
  pr-check            Run PR checks (TODO/FIXME scan)
  comment-scan        Scan for TODO/FIXME/print/debugPrint (alias)
  build               Build MainApp and ShareExtension (Release)
  size-report         Check ShareExtension size
  dev                 Build and launch MainApp in Simulator
  clean               Clean build artifacts
  logs                Stream MainApp logs
  bump-version        Bump version numbers via agvtool
  archive             Archive MainApp as .xcarchive
  export-ipa          Export IPA from archive
  deploy:testflight   Upload IPA to TestFlight via altool
  deploy:internal     Internal TestFlight deploy
  deploy:adhoc        Ad-hoc TestFlight deploy
  deploy:appstore     Upload to App Store Connect
  generate-changelog  Generate changelog via git-chglog
  notify              Send notifications (Slack, email)
  monitor-setup       Setup monitoring (Sentry etc.)
  help                Show this help
EOF
}

function init() {
  echo -e "${GREEN}Checking CLI tools via Homebrew...${NC}"
  local tools=(xcodegen swiftlint swiftformat xcbeautify swiftgen)
  for tool in "${tools[@]}"; do
    if ! command -v $tool &>/dev/null; then
      echo "Installing $tool..."
      brew install $tool
    else
      echo "$tool is already installed"
    fi
  done
  echo -e "${GREEN}All dependencies checked.${NC}"
}

function echo_section() {
  echo -e "\n\n"
  echo -e "${PURPLE}----------------------------------------${NC}"
  echo -e "${PURPLE}>>> $1${NC}"
  echo -e "${PURPLE}----------------------------------------${NC}"
}

function generate() {
  # Ensure output directories exist for SwiftGen
  mkdir -p src/MainApp/Resources/Generated
  mkdir -p src/Common/Generated
  echo_section "Running SwiftGen"
  swiftgen "$@"
  echo_section "Running XcodeGen"
  xcodegen "$@"
}

function fmt() {
  echo_section "Running SwiftFormat"
  swiftformat . "$@"
}

function lint() {
  echo_section "Running SwiftLint"
  swiftlint --strict "$@"
}

function test_unit() {
  generate "$@"
  echo_section "Running Unit Tests"
  rm -rf build/Results
  for scheme in "${SCHEMES_UNIT[@]}"; do
    xcb test -sdk iphonesimulator -destination "id=${TEST_SIMULATOR_ID}" -scheme "${scheme}" \
      -parallel-testing-enabled YES -resultBundlePath "build/Results/${scheme}.xcresult" "$@"
  done
}

function test_e2e() {
  generate "$@"
  echo_section "Running E2E Tests"
  rm -rf build/Results
  for scheme in "${SCHEMES_E2E[@]}"; do
    xcb test -sdk iphonesimulator -destination "id=${TEST_SIMULATOR_ID}" -scheme "${scheme}" \
      -parallel-testing-enabled YES -resultBundlePath "build/Results/${scheme}.xcresult"
  done
}

function test() {
  fmt "$@"
  lint "$@"
  analyze "$@"
  test_unit "$@"
  test_e2e "$@"
}

function build() {
  generate "$@"
  echo_section "Building MainApp (Release/iphoneos)"
  xcb build -scheme MainApp -configuration Release -sdk iphoneos -derivedDataPath build -allowProvisioningUpdates "$@"
  echo_section "Building ShareExtension (Release/iphoneos)"
  xcb build -scheme ShareExtension -configuration Release -sdk iphoneos -derivedDataPath build -allowProvisioningUpdates "$@"
}

function size_report() {
  generate "$@"
  echo_section "Cleaning build artifacts"
  rm -rf build
  echo_section "Building ShareExtension for size report (Release/iphoneos)"
  xcb build -scheme ShareExtension -configuration Release -sdk iphoneos -derivedDataPath build "$@"
  local appex=$(find build -name 'ShareExtension.appex' | head -n1)
  if [[ ! -f "$appex" ]]; then
    echo -e "${RED}Error: ShareExtension.appex not found!${NC}"
    exit 1
  fi
  local size_bytes=$(stat -f%z "$appex")
  local size_mb=$(awk "BEGIN {printf \"%.2f\", $size_bytes/1024/1024}")
  echo "ShareExtension.appex size: ${size_mb} MB (${size_bytes} bytes)"
  if (( $(echo "${size_mb} > 20.0" | bc -l) )); then
    echo -e "${RED}Error: ShareExtension size exceeds 20MB!${NC}"
    exit 1
  fi
}

function boot_and_wait_simulator() {
  # Проверяем состояние симулятора через JSON
  local sim_status
  sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')
  echo_section "Simulator ${SIMULATOR_ID} status: $sim_status"
  if [[ "$sim_status" != "Booted" ]]; then
    echo_section "Booting simulator ${SIMULATOR_ID}..."
    xcrun simctl boot "${SIMULATOR_ID}"
    # Ждём, пока симулятор не станет Booted
    for i in {1..20}; do
      sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')
      if [[ "$sim_status" == "Booted" ]]; then
        break
      fi
      sleep 1
    done
  else
    echo_section "Simulator already Booted."
  fi
}

function install_app_to_simulator() {
  local app_path="$1"
  if [[ ! -d "$app_path" ]]; then
    echo "${RED}MainApp.app not found at $app_path!${NC}"
    exit 2
  fi
  echo_section "Installing app to simulator: $app_path"
  local install_success=0
  for attempt in {1..5}; do
    if xcrun simctl install "${SIMULATOR_ID}" "${app_path}"; then
      install_success=1
      break
    else
      local delay=$((2 ** (attempt - 1)))
      echo "Install attempt $attempt failed, retrying in ${delay}s..."
      sleep "${delay}"
    fi
  done
  if [[ $install_success -eq 0 ]]; then
    echo "${RED}Failed to install app after multiple attempts!${NC}"
    exit 2
  fi
}

function deploy_simulator() {
  clean
  generate "$@"
  if [[ -z "${CI:-}" ]]; then
    echo_section "Opening Simulator"
    open -a Simulator
  fi
  echo_section "Building MainApp for simulator"
  xcb build -sdk iphonesimulator -destination "id=${SIMULATOR_ID}" -scheme MainApp build "$@"
  boot_and_wait_simulator
  local app_path
  app_path=$(xcodebuild -scheme MainApp -sdk iphonesimulator -showBuildSettings | awk -F'= ' '/BUILT_PRODUCTS_DIR/ {print $2"/MainApp.app"}' | head -n1)
  install_app_to_simulator "$app_path"
  echo_section "Launching app: $app_path"
  xcrun simctl launch "${SIMULATOR_ID}" "dev.korchasa.Craftify"
}

function clean() {
  echo_section "Cleaning build artifacts"
  rm -rf build
  xcodebuild clean -scheme MainApp || true
  xcodebuild clean -scheme ShareExtension || true
  xcodebuild clean -scheme Common || true
}

function logs() {
  echo_section "Streaming logs from MainApp and ShareExtension"
  xcrun simctl spawn booted log stream --predicate 'subsystem == "Craftify"' --style syslog
}

function comment_scan() {
  echo_section "Scanning for TODO/FIXME/print/debugPrint"
  grep -rE 'TODO|FIXME|print\\(|debugPrint\\(' src/ || true
}

function bump_version() {
  echo_section "Bumping version numbers"
  local marketing="${1:-}"
  if [[ -z "$marketing" ]]; then
    agvtool next-version -all
  else
    agvtool new-marketing-version "$marketing"
    agvtool next-version -all
  fi
}

function archive() {
  generate "$@"
  echo_section "Archiving MainApp"
  xcb archive \
    -scheme MainApp \
    -configuration Release \
    -archivePath build/MainApp.xcarchive \
    -allowProvisioningUpdates "$@"
}

function export_ipa() {
  echo_section "Exporting IPA from archive"
  xcb -exportArchive \
    -archivePath build/MainApp.xcarchive \
    -exportOptionsPlist ExportOptions.plist \
    -exportPath build/IPA "$@"
}

function deploy_testflight() {
  echo_section "Deploying IPA to TestFlight"
  if [[ -z "${API_KEY_PATH:-}" || -z "${API_ISSUER_ID:-}" ]]; then
    echo -e "${RED}Error: API_KEY_PATH or API_ISSUER_ID env vars not set${NC}"
    exit 1
  fi
  xcrun altool \
    --upload-app --type ios \
    --file build/IPA/MainApp.ipa \
    --apiKey "$API_KEY_PATH" --apiIssuer "$API_ISSUER_ID"
}

function coverage() {
  generate "$@"
  echo_section "Running tests with code coverage"
  xcb test \
    -scheme MainAppUnitTests \
    -enableCodeCoverage YES \
    -sdk iphonesimulator \
    -destination "id=${TEST_SIMULATOR_ID}" "$@"
  echo_section "Generating coverage report"
  xcrun xccov view --report build/Logs/Test/*.xcresult
}

# Supporting stubs for CI/CD pipelines
function build_sim() {
  echo_section "Building for Simulator (Debug)"
  xcb build \
    -scheme MainApp \
    -configuration Debug \
    -sdk iphonesimulator \
    -destination "id=${SIMULATOR_ID}" "$@"
}

function analyze() {
  echo_section "Running static analysis"
  xcb analyze \
    -scheme MainApp \
    -sdk iphoneos \
    -configuration Debug "$@"
}

function export_ipa_adhoc() {
  echo_section "Exporting AdHoc IPA"
  xcb -exportArchive \
    -archivePath build/MainApp.xcarchive \
    -exportOptionsPlist ExportOptionsAdHoc.plist \
    -exportPath build/IPA/ad-hoc "$@"
}

function deploy_internal() {
  echo_section "Deploying to internal TestFlight"
  deploy_testflight "$@"
}

function deploy_adhoc() {
  echo_section "Deploying AdHoc distribution"
  deploy_testflight "$@"
}

function deploy_appstore() {
  echo_section "Uploading to App Store Connect"
  xcrun altool \
    -upload-app --type ios \
    -file build/IPA/MainApp.ipa \
    -apiKey "$API_KEY_PATH" --apiIssuer "$API_ISSUER_ID"
}

function generate_changelog() {
  echo_section "Generating changelog"
  git-chglog -o CHANGELOG.md
}

function notify() {
  echo_section "Sending notifications"
  # integrate Slack/email notifications here
}

function monitor_setup() {
  echo_section "Setting up monitoring"
  # configure Sentry or other services
}

function pr_checks() {
  echo_section "Running PR checks (e.g. TODO/FIXME scan)"
  comment_scan "$@"
}

function collect_dsyms() {
  echo_section "Collecting artifacts & dSYMs"
  mkdir -p build/Artifacts
  cp -R build/MainApp.xcarchive/dSYMs build/Artifacts/
}

CMD="${1:-}"
shift || true

case "$CMD" in
  init) init "$@" ;;                   # Install CLI tools
  generate) generate "$@" ;;           # SwiftGen & XcodeGen
  fmt) fmt "$@" ;;                     # SwiftFormat
  lint) lint "$@" ;;                   # SwiftLint
  test:lint) lint "$@" ;;              # Launched lint as test:lint alias
  test:format) fmt "$@" ;;             # Launched fmt as test:format alias
  analyze) analyze "$@" ;;             # Static analysis
  test:unit) test_unit "$@" ;;         # Run unit tests
  test:e2e) test_e2e "$@" ;;           # Run end-to-end tests
  test) test "$@" ;;                   # Run unit & UI tests
  test:coverage) coverage "$@" ;;      # Run code coverage
  pr-check) pr_checks "$@" ;;          # Run PR checks (TODO/FIXME scan)
  comment-scan) comment_scan "$@" ;;   # Legacy alias for pr-check
  build) build "$@" ;;                 # Build release targets
  size-report) size_report "$@" ;;     # Check ShareExtension size
  clean) clean "$@" ;;                 # Clean artifacts
  logs) logs "$@" ;;                   # Stream device logs
  bump-version) bump_version "$@" ;;   # Bump version numbers
  archive) archive "$@" ;;             # Archive MainApp for distribution
  export-ipa) export_ipa "$@" ;;       # Export IPA from archive
  deploy:testflight) deploy_testflight "$@" ;;   # Upload to TestFlight via API key
  deploy:internal) deploy_internal "$@" ;;       # TestFlight internal deploy
  deploy:adhoc) deploy_adhoc "$@" ;;             # Ad-hoc TestFlight deploy
  deploy:appstore) deploy_appstore "$@" ;;       # Upload to App Store Connect
  deploy:simulator) deploy_simulator "$@" ;;     # Run app in simulator
  generate-changelog) generate_changelog "$@" ;; # Generate changelog via git-chglog
  notify) notify "$@" ;;               # Send notifications (Slack, email)
  monitor-setup) monitor_setup "$@" ;; # Setup monitoring (Sentry etc.)
  help|*) usage ;;                     # Show help
esac