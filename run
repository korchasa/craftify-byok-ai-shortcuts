#!/usr/bin/env bash
set -euo pipefail

# Default iOS Simulator UDID (override SIMULATOR_ID env var)
SIMULATOR_ID="EE50483C-9861-438F-82D0-52FFB8FDF92C"
# Simulator for tests
TEST_SIMULATOR_ID="A6CB3FE3-9CF3-458C-AC2E-7307FDF8D816"

# Colors for output
RED='\033[0;31m'
PURPLE='\033[0;35m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

SCRIPT_NAME=$(basename "${0}")

# Default parallel testing worker count
WORKER_COUNT=${TEST_WORKER_COUNT:-$(sysctl -n hw.ncpu)}
# === Общие переменные для ускорения сборки ===
DERIVED_DATA_FAST=build/DerivedData_FastCheck
RESULT_BUNDLE_PATH=build/Results/AllUnitTests.xcresult
SCHEME_ALL_TESTS=AllTests
SCHEME_MAINAPP=MainApp
DEST_SIMULATOR="id=${SIMULATOR_ID},arch=arm64"
DEST_TEST_SIMULATOR="id=${TEST_SIMULATOR_ID},arch=arm64"
# Для deploy:simulator отдельные артефакты
DERIVED_DATA_SIM=build/DerivedData_DeploySimulator
RESULT_BUNDLE_SIM=build/Results/DeploySimulator.xcresult

# Add xcb wrapper for xcodebuild with xcbeautify
function xcb() {
  xcodebuild -showBuildTimingSummary "$@" 2>&1 | grep -v 'DVTDeviceOperation: Encountered a build number' | xcbeautify --quiet --disable-logging
}


function usage() {
  cat <<EOF
Usage: $SCRIPT_NAME <command> [args...]
Commands:
  full-clean          Full clean: deletion of all builds, caches, logs, and temporary files
  sim                 Build MainApp for simulator
  generate            Run SwiftGen and XcodeGen
  init                Install CLI tools
  logs                Stream MainApp logs
  check               Run all checks (clean, generate, comment-scan, fmt, lint, analyze, build, test)
  test <test_id>      Run a test by id (e.g. MainAppUnitTests/TestExample). Always uses All plan.
  help                Show this help
EOF
}

function init() {
  echo -e "${GREEN}Checking CLI tools via Homebrew...${NC}"
  local tools=(xcodegen swiftlint swiftformat xcbeautify swiftgen)
  for tool in "${tools[@]}"; do
    if ! command -v $tool &>/dev/null; then
      echo "Installing $tool..."
      brew install $tool
    else
      echo "$tool is already installed"
    fi
  done
  echo -e "${GREEN}All dependencies checked.${NC}"
}

function _start_section() {
  echo -e "${PURPLE}========================================${NC}"
  echo -e "${PURPLE}>>> $1${NC}"
  SECTION_START_TIME=$(date +%s)
}

function _end_section() {
  local section_end_time=$(date +%s)
  local elapsed=$((section_end_time - SECTION_START_TIME))
  echo -e "${GREEN}<<< Section finished in ${elapsed}s${NC}"
  echo -e "${GREEN}========================================${NC}"
}

function clean() {
  _start_section "Cleaning build artifacts"
  rm -rf build
  rm -rf .build
  rm -rf .swiftpm
  rm -rf ~/Library/Developer/Xcode/DerivedData
  rm -rf ~/Library/Caches/org.swift.swiftpm
  rm -rf Craftify.xcodeproj/project.xcworkspace/xcuserdata
  rm -rf Craftify.xcodeproj/xcuserdata
  rm -rf Craftify.xcodeproj/xcshareddata/xcschemes
  rm -rf build/SourcePackages
  xcb clean || true
  _end_section
}

function generate() {
  mkdir -p src/MainApp/Resources/Generated
  mkdir -p src/Common/Generated
  _start_section "Running SwiftGen"
  swiftgen "$@"
  _end_section
  _start_section "Running XcodeGen"
  xcodegen "$@"
  _end_section
}

function fmt() {
  _start_section "Running SwiftFormat"
  swiftformat . --quiet "$@"
  _end_section
}

function lint() {
  _start_section "Running SwiftLint"
  swiftlint lint --fix --quiet
  swiftlint lint --strict --quiet
  _end_section
}

function _build() {
  _start_section "Building MainApp (Release/iphoneos)"
  xcb build -scheme MainApp -configuration Release -sdk iphoneos -derivedDataPath build/DerivedData_Build_MainApp -allowProvisioningUpdates
  _end_section
}

function size_report() {
  generate "$@"
  _start_section "Cleaning build artifacts"
  rm -rf build
  _end_section
  _start_section "Building ShareExtension for size report (Release/iphoneos)"
  xcb build -scheme ShareExtension -configuration Release -sdk iphoneos -derivedDataPath build/DerivedData_SizeReport_ShareExtension "$@"
  _end_section
  local appex=$(find build -name 'ShareExtension.appex' | head -n1)
  if [[ ! -f "$appex" ]]; then
    echo -e "${RED}Error: ShareExtension.appex not found!${NC}"
    exit 1
  fi
  local size_bytes=$(stat -f%z "$appex")
  local size_mb=$(awk "BEGIN {printf \"%.2f\", $size_bytes/1024/1024}")
  echo "ShareExtension.appex size: ${size_mb} MB (${size_bytes} bytes)"
  if (( $(echo "${size_mb} > 20.0" | bc -l) )); then
    echo -e "${RED}Error: ShareExtension size exceeds 20MB!${NC}"
    exit 1
  fi
}

function _boot_and_wait_simulator() {
  local sim_status
  sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')
  _start_section "Simulator ${SIMULATOR_ID} status: $sim_status"
  if [[ "$sim_status" != "Booted" ]]; then
    _start_section "Booting simulator ${SIMULATOR_ID}..."
    xcrun simctl boot "${SIMULATOR_ID}"
    for i in {1..20}; do
      sim_status=$(xcrun simctl list -j | jq -r '.devices[] | .[] | select(.udid=="'${SIMULATOR_ID}'") | .state')
      if [[ "$sim_status" == "Booted" ]]; then
        break
      fi
      sleep 1
    done
    _end_section
  else
    _start_section "Simulator already Booted."
    _end_section
  fi
  _end_section
}

function _install_app_to_simulator() {
  local app_path="$1"
  if [[ ! -d "$app_path" ]]; then
    echo "${RED}MainApp.app not found at $app_path!${NC}"
    exit 2
  fi
  local install_success=0
  for attempt in {1..5}; do
    if xcrun simctl install "${SIMULATOR_ID}" "${app_path}"; then
      install_success=1
      break
    else
      local delay=$((2 ** (attempt - 1)))
      echo "Install attempt $attempt failed, retrying in ${delay}s..."
      sleep "${delay}"
    fi
  done
  if [[ $install_success -eq 0 ]]; then
    echo "${RED}Failed to install app after multiple attempts!${NC}"
    exit 2
  fi
}

function fast_check_build_analyze_test() {
  _start_section "Fast build+analyze+test (MainApp, ShareExtension, AllUnitTests)"
  local t0=$(date +%s)
  rm -rf "$DERIVED_DATA_FAST" "$RESULT_BUNDLE_PATH"
  local t1=$(date +%s)
  xcb build analyze test \
    -scheme AllTests \
    -configuration Debug \
    -sdk iphonesimulator \
    -destination "$DEST_TEST_SIMULATOR" \
    -derivedDataPath "$DERIVED_DATA_FAST" \
    -parallel-testing-enabled YES \
    -parallel-testing-worker-count "${WORKER_COUNT}" \
    -resultBundlePath "$RESULT_BUNDLE_PATH" \
    -testLanguage en \
    -testRegion US
  local exit_code=$?
  local t2=$(date +%s)
  _end_section
  local t3=$(date +%s)
  echo -e "${YELLOW}==> fast_check_build_analyze_test: Finished at $(date)${NC}"
  echo -e "${YELLOW}==> Timing:${NC}"
  echo "  Prepare:   $((t1-t0))s"
  echo "  Build+Analyze+Test: $((t2-t1))s"
  echo "  Cleanup:   $((t3-t2))s"
  echo "  TOTAL:     $((t3-t0))s"
  return $exit_code
}

function deploy_simulator() {
  generate "$@"
  _start_section "Opening Simulator"
  open -a Simulator
  _end_section
  _start_section "Building MainApp for Simulator (Debug)"
  rm -rf "$DERIVED_DATA_SIM"
  xcb build \
    -scheme "$SCHEME_MAINAPP" \
    -configuration Debug \
    -sdk iphonesimulator \
    -destination "$DEST_SIMULATOR" \
    -derivedDataPath "$DERIVED_DATA_SIM"
  _end_section
  _boot_and_wait_simulator
  local app_path
  app_path=$(xcodebuild -scheme "$SCHEME_MAINAPP" -destination "$DEST_SIMULATOR" -sdk iphonesimulator -derivedDataPath "$DERIVED_DATA_SIM" -showBuildSettings | awk -F'= ' '/BUILT_PRODUCTS_DIR/ {print $2"/MainApp.app"}' | head -n1)
  _start_section "Installing app to simulator: $app_path"
  _install_app_to_simulator "$app_path"
  _end_section
  _start_section "Launching app in simulator: $app_path"
  xcrun simctl launch "${SIMULATOR_ID}" "dev.korchasa.Craftify"
  _end_section
  _start_section "Starting log stream to emulator.log (background)"
  xcrun simctl spawn booted log stream --predicate '(subsystem == "Internal") && (process == "MainApp" OR process == "ShareExtension")' --style syslog --level=debug > emulator.log 2>&1 &
  LOG_STREAM_PID=$!
  tail -f emulator.log
  _end_section
}

function logs() {
  _start_section "Streaming logs from MainApp и ShareExtension (все уровни, включая debug)"
  xcrun simctl spawn booted log stream --predicate '(subsystem == "Internal") && (process == "MainApp" OR process == "ShareExtension")' --style syslog --level=debug
  _end_section
}

function comment_scan() {
  _start_section "Scanning for TODO/FIXME/print/debugPrint"
  if grep -rE 'TODO|FIXME|print\(|debugPrint\(' src/; then
    echo -e "${RED}Error: TODO/FIXME/print/debugPrint found!${NC}"
    exit 1
  fi
  _end_section
}

function _build_sim() {
  _start_section "Building for Simulator (Debug)"
  xcb build \
    -scheme MainApp \
    -configuration Debug \
    -sdk iphonesimulator \
    -destination "id=${SIMULATOR_ID},arch=arm64" \
    -derivedDataPath build/DerivedData_BuildSim_MainApp "$@"
  _end_section
}

function analyze() {
  _start_section "Running static analysis for MainApp"
  xcb analyze \
    -scheme MainApp \
    -sdk iphoneos \
    -destination "id=${SIMULATOR_ID},arch=arm64" \
    -configuration Debug \
    -derivedDataPath build/DerivedData_Analyze_MainApp "$@"
  _end_section
  _start_section "Running static analysis for ShareExtension"
  xcb analyze \
    -scheme ShareExtension \
    -sdk iphoneos \
    -destination "id=${SIMULATOR_ID},arch=arm64" \
    -configuration Debug \
    -derivedDataPath build/DerivedData_Analyze_ShareExtension "$@"
  _end_section
}

function _test_scheme() {
  local scheme="$1"; shift
  local flags=("$@")
  local t0=$(date +%s)
  _start_section "Running tests scheme $scheme"
  rm -rf build/Results
  local t1=$(date +%s)
  xcb test \
    -scheme "$scheme" \
    -parallel-testing-enabled YES \
    -parallel-testing-worker-count "${WORKER_COUNT}" \
    -sdk iphonesimulator \
    -destination "id=${TEST_SIMULATOR_ID},arch=arm64" \
    -derivedDataPath "build/DerivedData_Test_${scheme}" \
    -resultBundlePath "build/Results/${scheme}.xcresult" \
    -collect-test-diagnostics on-failure \
    -testLanguage en \
    -testRegion US \
    "${flags[@]}"
  test_exit_code=$?
  local t2=$(date +%s)
  _end_section
  local t3=$(date +%s)
  echo -e "${YELLOW}==> test_scheme: Finished at $(date)${NC}"
  echo -e "${YELLOW}==> Timing:${NC}"
  echo "  Prepare:   $((t1-t0))s"
  echo "  Build+Run: $((t2-t1))s"
  echo "  Cleanup:   $((t3-t2))s"
  echo "  TOTAL:     $((t3-t0))s"
  if [ $test_exit_code -ne 0 ] && [ -f build/Results/AllTests.xcresult ]; then
    echo -e "${RED}Test failures summary:${NC}"
    xcrun xcresulttool get --legacy --path build/Results/AllTests.xcresult --format json | jq '.. | .testFailureSummaries? // empty'
  fi
  exit $test_exit_code
}

function full_clean() {
  _start_section "Full clean: удаление всех build, кэшей, логов и временных файлов"
  rm -rf build .build .swiftpm coverage *.log *.tmp *.temp
  rm -rf ~/Library/Developer/Xcode/DerivedData
  find . -type d -name DerivedData -exec rm -rf {} +
  find . -type f -name '*.xcresult' -delete
  find . -type f -name '*.ipa' -delete
  find . -type f -name '*.dSYM' -delete
  find . -type f -name '*.app' -delete
  find . -type f -name '*.xcarchive' -delete
  _end_section
}

CMD="${1:-}"
shift || true

case "$CMD" in
  full-clean) full_clean "$@" ;;
  sim) deploy_simulator "$@" ;;
  generate) generate "$@" ;;
  init) init "$@" ;;
  logs) logs "$@" ;;
  test)
    if [[ -z "$1" ]]; then
      usage
      exit 1
    fi
    test_id="$1"; shift
    _test_scheme AllTests -only-testing "$test_id" "$@"
    ;;
  check)
    generate || { echo -e "${RED}===CHECK_FAILED=== (generate)${NC}"; exit 1; }
    comment_scan || { echo -e "${RED}===CHECK_FAILED=== (comment_scan)${NC}"; exit 1; }
    fmt || { echo -e "${RED}===CHECK_FAILED=== (fmt)${NC}"; exit 1; }
    lint || { echo -e "${RED}===CHECK_FAILED=== (lint)${NC}"; exit 1; }
    fast_check_build_analyze_test || { echo -e "${RED}===CHECK_FAILED=== (test)${NC}"; exit 1; }
    ;;
  help|*) usage ;;
esac