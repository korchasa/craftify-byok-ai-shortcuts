#!/bin/bash
set -e

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

function help() {
  echo "Usage: ./run <command> [args...]"
  echo "Commands:"
  echo "  test      - Запуск тестов CraftifyShared"
  echo "  dev       - Сборка и запуск MainApp в симуляторе iPhone 14 (iOS 16.4)"
  echo "  clean     - Очистка артефактов сборки"
  echo "  logs      - Показать device logs (симулятор)"
  echo "  help      - Показать эту справку"
  echo "\nЛюбые дополнительные параметры после <command> будут переданы в соответствующий инструмент."
}

function ensure_mint() {
  if ! command -v mint &> /dev/null; then
    echo -e "${RED}Mint не найден. Установите через 'brew install mint'.${NC}"
    exit 1
  fi
}

SIMULATOR_ID=EE50483C-9861-438F-82D0-52FFB8FDF92C

CMD="$1"
shift || true # Удаляем имя команды, остальные параметры в $@

ensure_mint

case "$CMD" in
  test)
    echo ">>>> Run swiftformat"
    mint run swiftformat . "$@" || { echo -e "${RED}SwiftFormat обнаружил ошибки!${NC}"; exit 1; }
    echo ">>>> Run swiftlint"
    mint run swiftlint --strict "$@" || { echo -e "${RED}SwiftLint обнаружил ошибки!${NC}"; exit 1; }

    mint run xcodegen "$@"
    open -a Simulator

    echo ">>>> Run test"
    xcodebuild -scheme MainApp -sdk iphonesimulator -destination "id=$SIMULATOR_ID" test "$@" | mint run xcbeautify
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
      echo -e "${RED}MainApp тесты завершились с ошибкой!${NC}"
      exit 1
    fi
    xcodebuild -scheme ShareExtension -sdk iphonesimulator -destination "id=$SIMULATOR_ID" test "$@" | mint run xcbeautify
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
      echo -e "${RED}ShareExtension тесты завершились с ошибкой!${NC}"
      exit 1
    fi
    xcodebuild -scheme CraftifyShared -sdk iphonesimulator -destination "id=$SIMULATOR_ID" test "$@" | mint run xcbeautify
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
      echo -e "${RED}CraftifyShared тесты завершились с ошибкой!${NC}"
      exit 1
    fi
    ;;
  check-size)
    xcodebuild -scheme ShareExtension -sdk iphoneos -configuration Release -archivePath $PWD/build/ShareExtension.xcarchive archive "$@" | mint run xcbeautify
    EXT_PATH=$(find $PWD/build/ShareExtension.xcarchive/Products/ -name 'ShareExtension.appex' | head -n1)
    SIZE=$(du -m "$EXT_PATH" | cut -f1)
    echo "ShareExtension size: ${SIZE}MB"
    if [ "$SIZE" -gt 20 ]; then
      echo -e "${RED}ShareExtension size exceeds 20MB!${NC}"
      exit 1
    fi
    ;;
  dev)
    mint run xcodegen "$@"
    open -a Simulator
    xcodebuild -scheme MainApp -sdk iphonesimulator -destination "id=$SIMULATOR_ID" build "$@" | mint run xcbeautify
    xcrun simctl boot $SIMULATOR_ID || true
    xcrun simctl install $SIMULATOR_ID "$(xcodebuild -scheme MainApp -sdk iphonesimulator -showBuildSettings | grep -m1 'BUILT_PRODUCTS_DIR =' | awk '{print $3}')/MainApp.app"
    xcrun simctl launch $SIMULATOR_ID dev.korchasa.Craftify
    ;;
  clean)
    rm -rf build
    xcodebuild clean -scheme MainApp "$@" || true
    xcodebuild clean -scheme ShareExtension "$@" || true
    xcodebuild clean -scheme CraftifyShared "$@" || true
    ;;
  logs)
    xcrun simctl spawn booted log stream --predicate 'process == "MainApp"' --style syslog "$@"
    ;;
  help|--help|-h|*)
    help
    ;;
esac